<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Gml.Launcher.Views.Components">
    <Design.PreviewWith>
        <Border Background="{StaticResource BackgroundColor}"
                Padding="20">
            <StackPanel Spacing="30">
                <controls:LogoComponent Classes="Icon" />
                <controls:LogoComponent Classes="TextLogo" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|LogoComponent.Icon">
        <Setter Property="LogoPath" Value="{DynamicResource ThemeLogoPath}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Svg Path="{TemplateBinding LogoPath}"
                     Width="{TemplateBinding Size}"
                     Height="{TemplateBinding Size}"
                     IsVisible="{DynamicResource ThemeVisible.Logo}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|LogoComponent.TextLogo">
        <Setter Property="LogoPath" Value="{DynamicResource ThemeLogoPath}" />
        <Setter Property="BrandName" Value="{DynamicResource ThemeLayout.BrandName}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="15"
                            IsVisible="{DynamicResource ThemeVisible.Logo}">
                    <Svg Path="{TemplateBinding LogoPath}"
                         Width="{TemplateBinding Size}"
                         Height="{TemplateBinding Size}" />
                    <TextBlock Text="{TemplateBinding BrandName}"
                               VerticalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeadlineColor}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
